name: Java 26 Build and Test

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout source code
        uses: actions/checkout@v4

      - name: Set up JDK 26
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '26'
          cache: maven

      - name: Build and test
        run: mvn -B -ntp clean verify
  
  database-fresh-init:
    name: Verify fresh MySQL database
    runs-on: ubuntu-latest

    services:
      mysql:
        image: mysql:8.4
        env:
          MYSQL_ROOT_PASSWORD: ci_test_only
        ports:
          - 3306:3306
        options: >-
          --health-cmd="mysqladmin ping -h 127.0.0.1 -uroot -pci_test_only"
          --health-interval=10s
          --health-timeout=5s
          --health-retries=30

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Install MySQL client
        run: |
          sudo apt-get update
          sudo apt-get install -y default-mysql-client

      - name: Create database from SQL files
        env:
          MYSQL_PWD: ci_test_only
        run: |
          mysql -h 127.0.0.1 -uroot < database/Quanlydetaisinhvien.sql

          mysql -h 127.0.0.1 -uroot Quanlydetaisinhvien < database/migrations/pending/V002__phanconghoidong_emailketqua.sql

          mysql -h 127.0.0.1 -uroot Quanlydetaisinhvien < database/migrations/pending/V003__emailthongbao.sql

      - name: Verify 20 tables
        env:
          MYSQL_PWD: ci_test_only
        run: |
          COUNT=$(mysql -h 127.0.0.1 -uroot -N -e "
            SELECT COUNT(*)
            FROM information_schema.tables
            WHERE table_schema = 'Quanlydetaisinhvien'
              AND table_type = 'BASE TABLE';
          ")

          echo "Tables created: $COUNT"
          test "$COUNT" -eq 20

